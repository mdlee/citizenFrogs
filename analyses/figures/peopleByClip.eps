/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 354
  /ImageMatrix [654 0 0 354 0 0]
  /Width 654
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
